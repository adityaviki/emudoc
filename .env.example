# Copy this file to .env. Every setting has a working default except the model's API key.

# The AI model writes the summaries and facts, reads scans and images, and answers in the Ask
# tab. Leave the key empty to run without those: parsing, outlines and search still work.
# The default model is Gemini; create a key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Models, written provider:model. Indexing is the high-volume side; the agent answers in Ask.
# AGENT_MODEL=google:gemini-2.5-flash-lite
# INDEX_MODEL=google:gemini-2.5-flash-lite
# As of October 2026 Google serves Gemini 2.5 only to accounts that have used it before. If
# your key is refused, use google:gemini-3.5-flash-lite or reach 2.5 through OpenRouter.
#
# To switch, name another model and add the key its provider reads, for example:
#   google:gemini-3.5-flash-lite               GOOGLE_API_KEY
#   anthropic:claude-opus-5-5                  ANTHROPIC_API_KEY
#   openrouter:google/gemini-2.5-flash-lite    OPENROUTER_API_KEY (any model OpenRouter lists)
# The two models can come from different providers. Others that Pydantic AI supports follow the
# same pattern: https://pydantic.dev/docs/ai/models/overview/
#
# How hard the model thinks: minimal | low | medium | high | xhigh. Set it empty to leave the
# model's own default. Models that cannot think ignore it.
# AGENT_EFFORT=medium
# INDEX_EFFORT=low

# Embeddings for semantic search: any OpenAI-compatible /embeddings endpoint.
# The default is a local Ollama (run `ollama pull nomic-embed-text` once).
# Changing the model or its size re-embeds every document on the next start.
# EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
# EMBEDDING_API_KEY=
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIM=768
# EMBEDDING_QUERY_PREFIX="search_query: "
# EMBEDDING_DOCUMENT_PREFIX="search_document: "

# Database. POSTGRES_PORT is the host port docker-compose.yml publishes.
# POSTGRES_PORT=5437
# DATABASE_URL=postgresql+psycopg://paperless:paperless@127.0.0.1:5437/paperless

# Text search language (a Postgres text search configuration). Fixed once tables exist.
# FTS_LANGUAGE=english
# Documents indexed in parallel.
# WORKER_CONCURRENCY=2
# MAX_UPLOAD_MB=100
