# What the image is built from, and nothing else: everything is left out unless named here, so
# .env, the uploads in backend/data, the tests, a frontend .env.local and whatever lands in the
# checkout later never reach the build or the image. A file the app reads at run time, or the
# frontend's build needs, is added here, as is one a release on AWS runs from the image
# (deploy/aws/host/release).
*
!CHANGELOG.md
!backend/pyproject.toml
!backend/uv.lock
!backend/.python-version
!backend/alembic.ini
!backend/app/
!backend/migrations/
!frontend/package.json
!frontend/pnpm-lock.yaml
!frontend/index.html
!frontend/operator.html
!frontend/public/
!frontend/src/
frontend/src/**/*.test.ts
!frontend/tsconfig*.json
!frontend/vite.config.ts
!deploy/compose.yml
!deploy/managed-restore-drill.sh
!deploy/rds-drill.sh
!deploy/aws/compose.yml
!deploy/aws/Caddyfile
!deploy/aws/alertmanager.yml
!deploy/aws/host/
!deploy/prometheus/
**/__pycache__/
