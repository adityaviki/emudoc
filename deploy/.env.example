# Emudoc's settings for compose.yml beside this file: copy it to .env there and set the four
# values under "What you set". Compose fills compose.yml's ${…} from it, and the app's containers
# take every line as their environment. The rest are what compose.yml runs. Every other setting
# the app reads may be added here: .env.example at the repository's root lists them with their
# defaults, and deploying.md's "Every setting" says what each does. Compose expands $ in a value
# unless the value is in single quotes. Readable by its owner alone: chmod 600 .env.

# ---------------------------------------------------------------------------------------------
# What you set
# ---------------------------------------------------------------------------------------------

# Where people open the app, for the links in mail and the OAuth redirects; with the tls profile,
# the name Caddy fetches a certificate for, which must lead to this machine.
APP_URL=https://emudoc.example.com

# The database's password, made once, letters and digits so that it stands in DATABASE_URL
# below as it is: openssl rand -hex 24
POSTGRES_PASSWORD=

# The key the database's secrets are encrypted with (the authenticators of two-factor sign-in),
# made once: openssl rand -base64 32. Keep a copy apart from the backups: they are worthless
# without it, and with it they are no longer secret (deploying.md, "The encryption keys").
ENCRYPTION_KEYS=

# The models, as provider:model, and the key their provider reads. Gemini's key comes from
# https://aistudio.google.com/apikey; on its free tier Google may use what it is sent, so say
# GOOGLE_PAID_TIER=true once billing is on for the key's project. The root's .env.example lists
# the other providers (anthropic:, openai:, openrouter:, google-cloud:, ollama:) and their keys.
AGENT_MODEL=google:gemini-3.5-flash-lite
INDEX_MODEL=google:gemini-3.5-flash-lite
GOOGLE_API_KEY=
# GOOGLE_PAID_TIER=true

# ---------------------------------------------------------------------------------------------
# What compose.yml runs
# ---------------------------------------------------------------------------------------------

# The image's tag: latest follows each release; a version such as 0.1 takes that line's fixes
# alone, and 0.1.0 stays on one. An update is a new tag here, then the commands at the top of
# compose.yml.
EMUDOC_TAG=latest

# The services behind a profile, separated by commas: scan (ClamAV, with SCANNER_URL below),
# office (the converter, with CONVERTER_URL) and tls (Caddy on 80 and 443 for APP_URL's name).
# Uncomment each URL with its profile, never without it: a scanner named and not running holds
# every upload in the queue.
# COMPOSE_PROFILES=scan,office,tls
# SCANNER_URL=clamd://clamav:3310
# CONVERTER_URL=http://converter:8080

# The database, the files' volume and the embeddings server compose.yml runs.
DATABASE_URL=postgresql+psycopg://emudoc:${POSTGRES_PASSWORD}@postgres:5432/emudoc
STORAGE_URL=file:///var/lib/emudoc
EMBEDDING_BASE_URL=http://embeddings:8080/v1

# The backups `docker compose run --rm backup` writes, every night from a timer (deploying.md,
# "Backups"): the days each is kept, which is also how long a deleted document or account may
# outlive its deletion in them, and where they go, the backups volume unless a directory is
# named here, one the image's user (uid 10001) may write in, on another disk at best.
BACKUP_DAYS=14
# EMUDOC_BACKUPS=/mnt/backups/emudoc

# Mail, for the invitations and password resets the app would otherwise hand to an owner or admin
# to pass on, and the notices: an SMTP relay, or Resend with RESEND_API_KEY (deploying.md,
# "Mail").
# SMTP_URL=smtp://user:password@smtp.example.com:587
# MAIL_FROM="Emudoc <no-reply@example.com>"
