[Unit]
Description=Emudoc: the containers' AWS credentials
Wants=network-online.target
After=network-online.target
# The containers Docker starts at boot find theirs.
Before=docker.service
OnFailure=emudoc-alert@%n.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/emudoc/credentials

[Install]
WantedBy=multi-user.target
