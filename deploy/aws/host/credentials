#!/bin/bash
# The containers' AWS credentials (deploy/aws/modules/environment/iam.tf): the app role's for
# the API and the worker, the storage reader's for the restore drill's dry run, Alertmanager's
# for the alerts topics, each an hour's session written where its containers mount it, in the
# form the AWS SDKs' credential_process takes (boto3's, and Go's in Alertmanager, which reads
# it again for every message it sends).
# Run at boot before Docker starts the containers, and every quarter of an hour after
# (emudoc-credentials.timer), so the file holds at least 45 minutes whenever boto3 asks.
# The instance's own credentials never reach a container.

set -euo pipefail
# shellcheck source=/dev/null
. /etc/emudoc/host.env

# The image's group, which the app's containers run with and Alertmanager's is given
# (deploy/aws/compose.yml).
group=10001

renew() {
  local role=$1 dir=/run/emudoc/aws/$2
  install -d -m 0750 -o root -g "$group" "$dir"
  # The backquotes are JMESPath's, for the number 1 that credential_process asks for.
  # shellcheck disable=SC2016
  aws sts assume-role --role-arn "$role" --duration-seconds 3600 \
    --role-session-name "emudoc-$EMUDOC_ENVIRONMENT-$2" --output json \
    --query '{Version: `1`, AccessKeyId: Credentials.AccessKeyId, SecretAccessKey: Credentials.SecretAccessKey, SessionToken: Credentials.SessionToken, Expiration: Credentials.Expiration}' \
    >"$dir/.credentials.json"
  printf '[default]\nregion = %s\ncredential_process = cat /run/aws/credentials.json\n' \
    "$AWS_REGION" >"$dir/.config"
  chgrp "$group" "$dir/.credentials.json" "$dir/.config"
  chmod 0640 "$dir/.credentials.json" "$dir/.config"
  mv -f "$dir/.credentials.json" "$dir/credentials.json"
  mv -f "$dir/.config" "$dir/config"
}

umask 077
renew "$EMUDOC_APP_ROLE" app
renew "$EMUDOC_READER_ROLE" reader
renew "$EMUDOC_ALERTMANAGER_ROLE" alertmanager
