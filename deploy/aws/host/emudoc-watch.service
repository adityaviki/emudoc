# The host's watch (deploy/aws/host/watch): whether every container of the running release runs
# and is healthy, reported to the alerts topic when that changes. journalctl -u emudoc-watch
# keeps each look that found something.
[Unit]
Description=Emudoc: the containers' health, reported when it changes
After=docker.service
OnFailure=emudoc-alert@%n.service

[Service]
Type=oneshot
EnvironmentFile=/etc/emudoc/host.env
ExecStart=/usr/local/lib/emudoc/watch
TimeoutStartSec=5min
