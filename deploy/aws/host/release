#!/bin/bash
# A release on the AWS instance (deploying.md, "On AWS"), as root, from the image it deploys:
# emudoc-release (deploy/aws/modules/environment/emudoc-release) pulls the image, takes its
# deploy directory out and runs this, so that what a release does on the host comes with the
# image and staging runs it before production does.
#
#   release TAG
#
# The settings into /etc/emudoc (deploy/aws/host/settings), the containers' credentials and
# the database's authority, then deploy/compose.yml with deploy/aws/compose.yml over it: the
# migrations first, the API and the worker once they ran, Caddy in front, Prometheus and
# Alertmanager beside them. A migration that fails ends the release before anything running is
# replaced.

set -euo pipefail
# shellcheck source=/dev/null
. /etc/emudoc/host.env

tag=${1:?usage: $0 TAG}
deploy=$(cd "$(dirname "$0")/../.." && pwd)
host=$deploy/aws/host
image=$EMUDOC_REPOSITORY:$tag
umask 077

# What this release needs of the host's settings, which only the instance's first start writes:
# an instance made before the module gave them is replaced by applying the root.
for name in EMUDOC_ALERTMANAGER_ROLE EMUDOC_HEARTBEAT; do
  if [[ -z ${!name:-} ]]; then
    echo "$name is not in /etc/emudoc/host.env: apply the environment's OpenTofu root, which" \
      "replaces the instance, then release again." >&2
    exit 1
  fi
done

# One release at a time; the host's watch (host/watch) does not look while one runs, since the
# containers it replaces would be reported in trouble.
install -d -m 0755 /run/emudoc
exec {lock}>/run/emudoc/release.lock
if ! flock --nonblock "$lock"; then
  echo "Another release is running on this instance." >&2
  exit 1
fi

# The settings, into files of their own until the release succeeded: those in /etc/emudoc stay
# the running release's, for emudoc-compose and the drill.
install -d -m 0755 /etc/emudoc /usr/local/lib/emudoc
rm -rf /etc/emudoc/next
install -d -m 0700 /etc/emudoc/next
aws ssm get-parameters-by-path --path "$EMUDOC_PARAMETERS" --recursive --with-decryption \
  --output json | python3 "$host/settings" --path "$EMUDOC_PARAMETERS" --image "$image" \
  --environment "$EMUDOC_ENVIRONMENT" --alerts "$EMUDOC_ALERTS" --heartbeat "$EMUDOC_HEARTBEAT" \
  --out /etc/emudoc/next --home /etc/emudoc

# RDS's authority for the region, which signs the database's certificate. An old copy serves
# while the trust store cannot be reached: RDS announces a new authority years ahead.
ca=/etc/emudoc/rds-ca.pem
if curl -fsS --max-time 30 -o "$ca.part" \
  "https://truststore.pki.rds.amazonaws.com/$AWS_REGION/$AWS_REGION-bundle.pem"; then
  chmod 0644 "$ca.part"
  mv -f "$ca.part" "$ca"
elif [[ -s $ca ]]; then
  echo "RDS's certificate bundle could not be fetched; the copy from before serves." >&2
else
  echo "RDS's certificate bundle could not be fetched, and without it the app cannot check" \
    "the database's certificate." >&2
  exit 1
fi

# The host's scripts and units, as this release has them.
install -m 0755 "$host/credentials" /usr/local/lib/emudoc/credentials
install -m 0755 "$host/watch" /usr/local/lib/emudoc/watch
install -m 0755 "$host/compose" /usr/local/sbin/emudoc-compose
install -m 0644 "$host"/*.service "$host"/*.timer /etc/systemd/system/
systemctl daemon-reload
systemctl enable --quiet emudoc-credentials.service
systemctl start emudoc-credentials.service
systemctl enable --quiet --now emudoc-credentials.timer emudoc-watch.timer

export EMUDOC_COMPOSE_FILES="-f $deploy/compose.yml -f $deploy/aws/compose.yml"
export EMUDOC_COMPOSE_ENV=/etc/emudoc/next/compose.env EMUDOC_ENV=/etc/emudoc/next/emudoc.env
compose=/usr/local/sbin/emudoc-compose
# The release step, then the embeddings server with the download of its weights: `up` replaces
# the API and the worker before it runs what they wait for, so a migration or a download that
# failed there, or a server that did not start, would leave neither running. Here a failure
# ends the release with the old ones serving.
$compose run --rm --no-deps migrate
$compose up --detach --wait embeddings
# Then the rest, the steps above again (done, they do nothing). A first release waits for
# ClamAV's signatures.
$compose up --detach --wait --wait-timeout 1200 --remove-orphans

mv -f /etc/emudoc/next/* /etc/emudoc/
rmdir /etc/emudoc/next
unset EMUDOC_COMPOSE_ENV EMUDOC_ENV
ln -sfn "$deploy" /opt/emudoc/current.part
mv -T /opt/emudoc/current.part /opt/emudoc/current
echo "$tag" >/etc/emudoc/release

if [[ $EMUDOC_DRILL == yes ]]; then
  systemctl enable --quiet --now emudoc-restore-drill.timer
else
  systemctl disable --quiet --now emudoc-restore-drill.timer
fi

# The three releases before this one stay, for going back without a pull; older ones go, and
# their images with them. Tags hold no spaces.
mapfile -t older < <(find /opt/emudoc/releases -mindepth 1 -maxdepth 1 -type d \
  ! -name "$tag" -printf '%T@ %f\n' | sort -rn | cut -d ' ' -f 2)
for old in "${older[@]:3}"; do
  rm -rf "/opt/emudoc/releases/$old"
  docker image rm "$EMUDOC_REPOSITORY:$old" >/dev/null 2>&1 || true
done

$compose ps
echo "Emudoc $tag runs on $EMUDOC_ENVIRONMENT."
