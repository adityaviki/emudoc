#!/bin/bash
# The host's way into a release (instance.tf): pulls the image TAG, takes out the deploy
# directory it carries and runs its deploy/aws/host/release, so that what a release does on
# the host comes with the image. Without TAG it runs the release deploy/aws/release.sh
# recorded, as a new instance does at its first start (emudoc-boot.service).
#
#   emudoc-release [TAG]

set -euo pipefail
# shellcheck source=/dev/null
. /etc/emudoc/host.env

tag=${1:-}
if [[ -z $tag ]]; then
  tag=$(aws ssm get-parameter --name "$EMUDOC_PARAMETERS/release" \
    --query Parameter.Value --output text)
  if [[ $tag == none ]]; then
    echo "No release is recorded yet: deploy/aws/release.sh runs the first."
    exit 0
  fi
fi
# A tag as Docker spells one, which is all that reaches the commands below.
if [[ ! $tag =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$ ]]; then
  echo "$tag is not an image tag." >&2
  exit 2
fi

image=$EMUDOC_REPOSITORY:$tag
docker pull --quiet "$image" >/dev/null
releases=/opt/emudoc/releases
dir=$releases/$tag
if [[ ! -d $dir ]]; then
  mkdir -p "$releases"
  rm -rf "$dir.part"
  container=$(docker create "$image")
  trap 'docker rm "$container" >/dev/null' EXIT
  docker cp --quiet "$container:/app/deploy" "$dir.part"
  mv -T "$dir.part" "$dir"
fi
"$dir/aws/host/release" "$tag"
